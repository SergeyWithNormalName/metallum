  "manual_scene_specs": [
    {"id": "single-white-torch-room", "contract": "sealed dark room; one white torch"},
    {"id": "rgb-light-room", "contract": "same room; isolated red, green and blue emitters"},
    {"id": "one-block-occluder", "contract": "one full block between emitter and camera"},
    {"id": "partial-shape-occluders", "contract": "slab, stairs, fence, pane and leaves before emitter"},
    {"id": "moving-entity-shadow", "contract": "entity crosses emitter-to-wall path"},
    {"id": "exposure-transition", "contract": "entity/camera crosses bright-to-dark boundary"},
    {"id": "sun-cascade-motion", "contract": "sunrise, sunset and cascade-boundary motion"},
    {"id": "weather-sky-change", "contract": "rain/thunder with fast sky-light transition"},
    {"id": "water-glass", "contract": "camera above/below water with glass in view"},
    {"id": "lava-particles", "contract": "lava plus emissive particles"},
    {"id": "dimension-matrix", "contract": "Nether, End and one custom dimension"},
    {"id": "chunk-boundary-churn", "contract": "load/unload chunks near camera"},
    {"id": "camera-discontinuities", "contract": "fast flight, teleport and FOV change"},
    {"id": "display-discontinuities", "contract": "resize, fullscreen and SDR/EDR display move"},
    {"id": "low-scale-diagnostics", "contract": "low render scale with motion/reactive diagnostics"},
    {"id": "lighting-output-matrix", "contract": "all four lighting/output combinations at one pose"},
    {"id": "unknown-render-role", "contract": "custom role must adapt or atomically fall back lighting only"},
    {"id": "frame-interpolation-ui", "contract": "camera, GUI, cursor, pause/menu and camera cut"}
  ]
