{
  "schemaVersion": 1,
  "id": "metallum",
  "version": "${version}",
  "name": "Metallum",
  "description": "Experimental Metal rendering backend for Minecraft on macOS with native EDR HDR output",
  "authors": [
    "kokodio"
  ],
  "contact": {
    "homepage": "https://github.com/kokodio/metallum",
    "sources": "https://github.com/kokodio/metallum"
  },
  "license": "MIT",
  "accessWidener": "metallum.accesswidener",
  "icon": "assets/metallum/icon.png",
  "environment": "client",
  "entrypoints": {
    "sodium:config_api_user": [
      "com.metallum.client.gui.MetallumSodiumConfig"
    ]
  },
  "mixins": [
    "metallum.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.2-",
    "java": ">=25",
    "sodium": ">=0.9.1"
  }
}
